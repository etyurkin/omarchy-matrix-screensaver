#!/bin/bash

# Omarchy screensaver running the effect selected with omarchy-screensaver-set.
#
# Runs inside the fullscreen screensaver terminal spawned by
# omarchy-launch-custom-screensaver. Adapted from the packaged
# omarchy-screensaver; the only real change is reading the chosen effect from
# state instead of always passing --random-effect.

STATE_FILE="$HOME/.local/state/omarchy/current/screensaver.name"

effect=$(cat "$STATE_FILE" 2>/dev/null || true)

# An unset or stale selection (an effect dropped by a ttfx upgrade) must not
# reach ttfx: an unknown subcommand makes it exit immediately, which would spin
# the restart loop below at full tilt. Fall back to stock random behaviour --
# but only when the list itself succeeded: a failing list says nothing about
# the selection, and "random" is a ttfx effect, so resetting on a list failure
# would trade a valid python-rendered selection for a guaranteed-broken one.
if [[ -z $effect ]]; then
  effect="random"
elif available=$(omarchy-screensaver-list 2>/dev/null); then
  grep -qxF "$effect" <<<"$available" || effect="random"
fi

# omarchy-matrix is rendered here; everything else is a ttfx effect, run as
# ttfx ships it.
renderer=ttfx
effect_args=()
case $effect in
random) effect_args=(--random-effect) ;;
omarchy-matrix) renderer=omarchy-matrix-fx ;;
*) effect_args=("$effect") ;;
esac

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
  [[ -n ${fx_pid:-} ]] && kill "$fx_pid" 2>/dev/null
  pkill -x ttfx 2>/dev/null
  pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null
  exit 0
}

# Exit the screensaver on signals and input from keyboard and mouse
trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'  # Set background color to black

hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

tty=$(tty 2>/dev/null)

# Terminals allocate the pty at the default 80x24 and only resize it once the
# compositor has told the window how big it is. ttfx measures the terminal once,
# at startup, so starting it before the resize lands sizes an 80x24 canvas and
# paints it into the corner of a fullscreen window.
wait_for_terminal_resize() {
  local deadline=$((SECONDS + 2))
  while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
    sleep 0.02
  done
}

wait_for_terminal_resize

while true; do
  started=$SECONDS

  if [[ $renderer == omarchy-matrix-fx ]]; then
    omarchy-matrix-fx -i ~/.config/omarchy/branding/screensaver.txt &
  else
    ttfx -i ~/.config/omarchy/branding/screensaver.txt \
      --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
      --no-eol --no-restore-cursor \
      "${effect_args[@]}" &
  fi
  fx_pid=$!

  # Watch the PID rather than pgrep'ing for a process name: the renderer is
  # either ttfx or a python script, and only one of those has a matchable comm.
  while kill -0 "$fx_pid" 2>/dev/null; do
    if read -n1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done

  # Belt and braces alongside the validation above: if ttfx still manages to die
  # on startup, don't respin it as fast as the CPU allows.
  ((SECONDS - started < 1)) && sleep 1
done
